# Copy to .env and fill in. NEVER commit .env.
ENVIRONMENT=development

# Postgres
POSTGRES_DSN=postgresql+psycopg://appuser:apppass@postgres:5432/aisearch

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key
AZURE_OPENAI_API_VERSION=2024-10-21

# Backend selection (swap implementations without code changes)
VECTOR_BACKEND=qdrant
LLM_BACKEND=azure_openai          # chat only
EMBEDDING_BACKEND=azure_openai    # azure_openai | local
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5   # used when EMBEDDING_BACKEND=local

# --- SharePoint per-tenant credentials (Job A: app-only Graph access) ---
# One block per M365 tenant. The prefix = the bot YAML `sharepoint.tenant`
# name, uppercased with '-' -> '_'. Add a new tenant = add three lines here.
VEELEAD_DEVELOPMENT_TENANT_ID=
VEELEAD_DEVELOPMENT_CLIENT_ID=
VEELEAD_DEVELOPMENT_CLIENT_SECRET=
VEELEAD_DEVELOPMENT_AUTH_CLIENT_ID=     # Login app (Job B) — no SharePoint access
VEELEAD_DEVELOPMENT_API_AUDIENCE=       # Login app (Job B)

VEELEAD_SOLUTIONS_TENANT_ID=
VEELEAD_SOLUTIONS_CLIENT_ID=
VEELEAD_SOLUTIONS_CLIENT_SECRET=

# --- Cross-origin API access (e.g. an SPFx web part calling /api/ask/* from
# a SharePoint origin) - see docs/SPFX_API_ACCESS.md. Comma-separated,
# empty/unset = no CORS middleware at all (today's same-origin-only behavior).
CORS_ALLOWED_ORIGINS=
